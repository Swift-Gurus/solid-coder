{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DRY Review Output",
  "type": "object",
  "required": [
    "agent",
    "principle",
    "timestamp",
    "files"
  ],
  "properties": {
    "agent": {
      "const": "dry"
    },
    "principle": {
      "const": "Don't Repeat Yourself"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "all_compliant": {
      "type": "boolean"
    },
    "documentation_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "description": "Per-file analysis results",
      "items": {
        "type": "object",
        "required": [
          "file_path",
          "units"
        ],
        "properties": {
          "file_path": {
            "type": "string",
            "description": "Full path to the reviewed file"
          },
          "units": {
            "type": "array",
            "description": "Per-unit analysis results within this file",
            "items": {
              "type": "object",
              "required": [
                "unit_name",
                "unit_kind",
                "metrics",
                "findings"
              ],
              "properties": {
                "unit_name": {
                  "type": "string",
                  "description": "Name of the analyzed unit"
                },
                "unit_kind": {
                  "type": "string",
                  "enum": [
                    "class",
                    "struct",
                    "enum",
                    "protocol",
                    "extension",
                    "function"
                  ],
                  "description": "Kind of the analyzed unit"
                },
                "metrics": {
                  "type": "object",
                  "description": "Detected duplication metrics",
                  "properties": {
                    "duplication_type": {
                      "type": "string",
                      "enum": [
                        "structural",
                        "inlined",
                        "missing_abstraction"
                      ]
                    },
                    "duplicate_sites": {
                      "type": "integer"
                    },
                    "shared_algorithm": {
                      "type": "string"
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "reuse_potential": {
                      "type": "string"
                    }
                  }
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "metric_id",
                      "severity",
                      "summary",
                      "location"
                    ],
                    "properties": {
                      "metric_id": {
                        "type": "string",
                        "enum": [
                          "DRY-1",
                          "DRY-2",
                          "DRY-3"
                        ]
                      },
                      "severity": {
                        "type": "string",
                        "enum": [
                          "SEVERE"
                        ]
                      },
                      "summary": {
                        "type": "string"
                      },
                      "location": {
                        "type": "string"
                      },
                      "duplicate_of": {
                        "type": "string"
                      },
                      "reasoning": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
