{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ISP Review Output",
  "type": "object",
  "required": ["agent", "principle", "timestamp", "files"],
  "properties": {
    "agent": { "const": "isp" },
    "principle": { "const": "Interface Segregation Principle" },
    "timestamp": { "type": "string", "format": "date-time" },
    "all_compliant": { "type": "boolean" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_path", "units"],
        "properties": {
          "file_path": { "type": "string" },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["unit_name", "unit_kind", "metrics"],
              "properties": {
                "unit_name": { "type": "string" },
                "unit_kind": { "type": "string" },
                "metrics": {
                  "type": "object",
                  "required": ["width", "min_coverage", "cohesion_groups"],
                  "properties": {
                    "width": {
                      "type": "integer",
                      "description": "Total number of methods/properties declared in the protocol"
                    },
                    "min_coverage": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Minimum meaningful implementation coverage across all conformers (0–100)"
                    },
                    "cohesion_groups": {
                      "type": "integer",
                      "description": "Number of disjoint method-usage groups across conformers"
                    }
                  }
                },
                "findings": { "type": "array" },
                "scoring": { "type": "array" }
              }
            }
          }
        }
      }
    }
  }
}
