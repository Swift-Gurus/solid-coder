{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ISP Review Output",
  "type": "object",
  "required": [
    "agent",
    "principle",
    "timestamp",
    "files"
  ],
  "properties": {
    "agent": {
      "const": "isp"
    },
    "principle": {
      "const": "Interface Segregation Principle"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "all_compliant": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file_path",
          "units"
        ],
        "properties": {
          "file_path": {
            "type": "string"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "unit_name",
                "unit_kind",
                "findings"
              ],
              "properties": {
                "unit_name": {
                  "type": "string"
                },
                "unit_kind": {
                  "type": "string"
                },
                "metrics": {
                  "type": "object"
                },
                "findings": {
                  "type": "array"
                },
                "scoring": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    }
  }
}
