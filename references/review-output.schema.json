{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Output",
  "description": "Unified schema for all principle review outputs. Each principle key inside 'metrics' follows that principle's own review/output.schema.json.",
  "type": "object",
  "required": ["timestamp", "files"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["units"],
        "properties": {
          "file_path": { "type": "string" },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["unit_name", "unit_kind", "metrics"],
              "properties": {
                "unit_name": { "type": "string" },
                "unit_kind": {
                  "type": "string",
                  "enum": ["class", "struct", "enum", "protocol", "extension", "actor", "function"]
                },
                "line_start": {
                  "type": "integer",
                  "description": "Optional start line of this unit in the source file. Used for changed-range filtering."
                },
                "line_end": {
                  "type": "integer",
                  "description": "Optional end line of this unit in the source file. Used for changed-range filtering."
                },
                "metrics": {
                  "type": "object",
                  "description": "Keys are principle names (e.g. 'SRP', 'OCP'). Each value follows that principle's review/output.schema.json (metrics sub-object schema).",
                  "additionalProperties": {
                    "type": "object",
                    "description": "Principle-specific metrics. Each measurement records its value, exception classification, reasoning, and source evidence.",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["value", "is_exception", "additional_info"],
                      "properties": {
                        "value": {
                          "description": "Measured metric value scored against severity bands.",
                          "type": ["integer", "string", "number"]
                        },
                        "is_exception": {
                          "type": "boolean",
                          "description": "Whether this measurement is excluded from severity scoring by the matching principle exception rules."
                        },
                        "additional_info": {
                          "type": "object",
                          "required": ["reasoning", "evidence"],
                          "properties": {
                            "reasoning": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Why the submitted value and exception classification are correct."
                            },
                            "evidence": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Relevant source excerpt, line reference, or precise code observation supporting the reasoning."
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "violations": {
                  "type": "array",
                  "description": "Server-generated. Do not include in submissions — the server fills this after scoring.",
                  "items": {
                    "type": "object",
                    "required": ["rule_id", "severity"],
                    "properties": {
                      "rule_id": {
                        "type": "string",
                        "description": "Rule identifier that fired, e.g. 'SRP-1', 'OCP-2'. Encodes the principle by prefix."
                      },
                      "severity": {
                        "type": "string",
                        "enum": ["SEVERE", "MINOR"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
