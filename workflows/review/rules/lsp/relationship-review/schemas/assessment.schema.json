{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "location",
    "name",
    "classification",
    "violations",
    "reasoning",
    "evidence"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate-[1-9][0-9]*$"
    },
    "location": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "classification": {
      "type": "string",
      "enum": ["BASE_DECLARATION", "RELATED_CONTRACT", "NOT_RELEVANT"]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "classification",
          "member",
          "is_exception",
          "reasoning",
          "evidence"
        ],
        "properties": {
          "classification": {
            "type": "string",
            "enum": [
              "NEW_GUARD",
              "WEAKENED_POSTCONDITION",
              "INVARIANT_VIOLATION"
            ]
          },
          "member": {"type": "string", "minLength": 1},
          "is_exception": {"type": "boolean"},
          "reasoning": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "reasoning": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1}
  }
}
