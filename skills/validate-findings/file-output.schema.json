{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validated File Output",
  "description": "Filtered violations and suggestions for a single file, grouped by principle.",
  "type": "object",
  "required": ["file_path", "timestamp", "principles"],
  "properties": {
    "file_path": {
      "type": "string",
      "description": "Full path to the source file"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "principles": {
      "type": "array",
      "description": "One entry per principle that has violations for this file",
      "items": {
        "type": "object",
        "required": ["principle", "severity", "violations", "suggestions"],
        "properties": {
          "principle": {
            "type": "string",
            "description": "Principle name or prefix (e.g. 'SRP', 'OCP')"
          },
          "unit_name": {
            "type": "string",
            "description": "Name of the unit (class, struct, protocol, etc.) this entry covers"
          },
          "unit_kind": {
            "type": "string",
            "description": "Kind of the unit (class, struct, enum, protocol, extension)"
          },
          "severity": {
            "type": "string",
            "enum": ["COMPLIANT", "MINOR", "SEVERE"],
            "description": "Worst severity among remaining violations for this principle on this unit"
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule_id", "severity"],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "description": "Rule identifier that fired, e.g. 'SRP-1'. Encodes the principle by prefix."
                },
                "severity": {
                  "type": "string",
                  "enum": ["SEVERE", "MINOR"]
                }
              }
            }
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["addresses", "severity", "suggested_fix"],
              "properties": {
                "id": { "type": "string" },
                "addresses": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "rule_id values this suggestion resolves"
                },
                "title": { "type": "string" },
                "severity": { "type": "string" },
                "suggested_fix": { "type": "string" },
                "todo_items": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
